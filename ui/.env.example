NEXT_PUBLIC_ALCHEMY_CELO_MAINNET_API="https://forno.celo.org"
NEXT_PUBLIC_WALLETCONNECT_ID="444e8c9b1c9d0a1e5f2b2c3d4e5f6a7"
NEXT_PUBLIC_API_URL="/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Runtime (pooled) connection — used by Prisma Client + PrismaPg adapter
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Direct connection for migrations/CLI — for Prisma Postgres, use the direct (non-pooled) URL
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Backend
BACKEND_SIGNER_PRIVATE_KEY="0xYOUR_BACKEND_SIGNER_PRIVATE_KEY"
# DB_MANAGER signs SpinPrizeVault.creditReward (can match backend signer initially)
DB_MANAGER_PRIVATE_KEY="0xYOUR_DB_MANAGER_PRIVATE_KEY"
SESSION_SECRET="YOUR_SESSION_SECRET"

# Contracts (Celo mainnet 42220 — fill after deploy + sync-data)
NEXT_PUBLIC_REWARD_TREASURY_ADDRESS="0x..."
NEXT_PUBLIC_POINTS_MANAGER_ADDRESS="0x..."
NEXT_PUBLIC_ACTIVITY_REGISTRY_ADDRESS="0x..."
NEXT_PUBLIC_SPIN_REWARD_MANAGER_ADDRESS="0x..."
NEXT_PUBLIC_SPIN_PRIZE_VAULT_ADDRESS="0x..."
NEXT_PUBLIC_SPIN_ECONOMY_ADDRESS="0x..."

# Skill boost fees: flat treasury deposits (not wagers). MiniPay → USDm; else → CELO.

# MiniPay
NEXT_PUBLIC_MINIPAY_CLIENT_ID="YOUR_MINIPAY_CLIENT_ID"
NEXT_PUBLIC_MINIPAY_URL="https://minipay.opera.com"
